<ui:Page
    x:Class="STranslate.Views.Pages.GlossaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:STranslate.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.ViewModels.Pages"
    Title="Glossary"
    d:DataContext="{d:DesignInstance Type=vm:GlossaryViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="850"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ui:Page.Resources>
        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static ui:ThemeKeys.TextControlForegroundKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.TextControlForegroundKey}}" />
        </Style>
    </ui:Page.Resources>
    <Grid Margin="20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                DockPanel.Dock="Left"
                Style="{DynamicResource {x:Static ui:ThemeKeys.SubtitleTextBlockStyleKey}}"
                Text="{DynamicResource Glossary}" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,8"
                Opacity="0.7"
                Text="{DynamicResource GlossaryDescription}"
                TextWrapping="Wrap" />
            <Border
                Grid.Row="1"
                Background="{DynamicResource SettingsCardBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource {x:Static ui:ThemeKeys.ControlCornerRadiusKey}}">
                <DataGrid
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding Entries}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                            Header="{DynamicResource GlossarySource}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                            Header="{DynamicResource GlossaryTarget}" />
                        <DataGridTemplateColumn Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <control:IconButton
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}"
                                        ToolTip="{DynamicResource Delete}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,0"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding AddCommand}"
                    Content="{DynamicResource Add}" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ImportCommand}"
                    Content="{DynamicResource GlossaryImport}" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding ExportCommand}"
                    Content="{DynamicResource GlossaryExport}" />
                <control:IconButton
                    Command="{Binding ClearCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    Icon="{x:Static ui:FluentSystemIcons.DeleteLines_20_Regular}"
                    ToolTip="{DynamicResource GlossaryClearAll}" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{DynamicResource GlossaryUsageHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:Page>
