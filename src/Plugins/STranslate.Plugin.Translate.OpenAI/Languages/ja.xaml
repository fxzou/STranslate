<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode">API モード</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_Description">幅広い OpenAI 互換サービスには Chat Completions、Responses API には Responses を選択します。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_ChatCompletions">Chat Completions</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_Responses">Responses</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_NoTextOutput">API からテキストが返されませんでした。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_AdditionalParameters">追加リクエストパラメーター</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_AdditionalParameters_Description">リクエストのルートにマージする JSON オブジェクトを入力します。プラグインが生成する組み込みフィールドは上書きできません。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_SendTemperature">温度パラメーターを送信</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_EnablePromptCaching">プロンプトキャッシュ</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_EnablePromptCaching_Description">安定した prompt_cache_key を送信し、再利用可能な system プレフィックスをキャッシュブレークポイントとして指定することで、繰り返しのリクエストがキャッシュ済みプレフィックスを再利用できます。互換サービスがこれらのフィールドを受け付けない場合は無効にしてください。</sys:String>
</ResourceDictionary>
