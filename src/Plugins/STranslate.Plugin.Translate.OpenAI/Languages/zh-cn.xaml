<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode">API 模式</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_Description">Chat Completions 兼容更多 OpenAI 格式服务，Responses 使用新版 Responses API。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_ChatCompletions">Chat Completions</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_Responses">Responses</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_NoTextOutput">API 未返回任何文本内容。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_AdditionalParameters">附加请求参数</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_AdditionalParameters_Description">填写要合并到请求根对象的 JSON。不能覆盖插件生成的内置字段。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_SendTemperature">发送温度参数</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_EnablePromptCaching">提示词缓存</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_EnablePromptCaching_Description">发送稳定的 prompt_cache_key，并把可复用的 system 前缀标记为缓存断点，让重复请求复用已缓存的前缀。若第三方兼容服务不接受这些字段，可关闭此项。</sys:String>
</ResourceDictionary>
