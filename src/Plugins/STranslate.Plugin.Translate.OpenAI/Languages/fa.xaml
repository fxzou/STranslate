<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode">حالت API</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_Description">گزینه Chat Completions را برای پشتیبانی از طیف وسیعی از سرویس‌های سازگار با OpenAI یا گزینه Responses را برای API جدید انتخاب کنید.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_ChatCompletions">Chat Completions</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_ApiMode_Responses">Responses</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_NoTextOutput">پاسخ API شامل خروجی متنی نبود.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_AdditionalParameters">پارامترهای اضافی درخواست</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_AdditionalParameters_Description">یک شیء JSON وارد کنید تا با ریشه درخواست ادغام شود. فیلدهای داخلی تولیدشده توسط افزونه قابل بازنویسی نیستند.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_SendTemperature">ارسال پارامتر دما</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_EnablePromptCaching">کش پرامپت</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_OpenAI_EnablePromptCaching_Description">ارسال prompt_cache_key پایدار و علامت‌گذاری پیشوند قابل استفادهٔ مجدد system به‌عنوان نقطهٔ کش، تا درخواست‌های تکراری بتوانند از پیشوند کش‌شده استفاده کنند. اگر سرویس سازگار شخص ثالث این فیلدها را نمی‌پذیرد، این گزینه را خاموش کنید.</sys:String>
</ResourceDictionary>
